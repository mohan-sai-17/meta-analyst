# ── Chatbot (chatbot/rag_server.py + chatbot/embed_stocks.py) ─────────────────

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=meta-analyst-stocks

# Groq
GROQ_API_KEY=your-groq-api-key

# ── AWS (pipeline Lambda + chatbot embed_stocks.py) ───────────────────────────

AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=meta-analyst-data-lake-YOUR_AWS_ACCOUNT_ID

# ── Frontend (cloud/frontend/.env.local) ──────────────────────────────────────

NEXT_PUBLIC_API_URL=https://YOUR_LAMBDA_URL.lambda-url.us-east-1.on.aws
NEXT_PUBLIC_RAG_URL=http://localhost:8001
